<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>autodrive_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and YAML configuration for bringing up the autodrive stack. autodrive_missions is intentionally never launched from core.launch.py.</description>
  <maintainer email="ahnjskevin@naver.com">rozen</maintainer>
  <license>TODO: License declaration</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>autodrive_description</exec_depend>
  <exec_depend>autodrive_sensors</exec_depend>
  <exec_depend>autodrive_perception</exec_depend>
  <exec_depend>autodrive_localization</exec_depend>
  <exec_depend>autodrive_planning</exec_depend>
  <exec_depend>autodrive_control</exec_depend>
  <exec_depend>autodrive_safety</exec_depend>
  <exec_depend>autodrive_vehicle</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
