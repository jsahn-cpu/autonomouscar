<?xml version="1.0"?>
<robot name="autodrive" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Vehicle geometry properties for the kinematic bicycle model.
    These values are the initial measurements and may be refined later.
  -->
  <xacro:property name="wheelbase" value="0.545"/>    <!-- [m] front-to-rear axle distance -->
  <xacro:property name="track_width" value="0.430"/>  <!-- [m] left-to-right wheel distance -->
  <xacro:property name="camera_height" value="0.68"/> <!-- [m] camera height above base_link -->

  <!--
    TODO: camera_front extrinsic is a placeholder. Replace x/y/z and roll/pitch/yaw
    below with the measured/calibrated values once the physical mount is finalized.
  -->
  <xacro:property name="camera_front_x" value="${wheelbase / 2.0}"/>
  <xacro:property name="camera_front_y" value="0.0"/>
  <xacro:property name="camera_front_z" value="${camera_height}"/>
  <xacro:property name="camera_front_roll" value="0.0"/>
  <xacro:property name="camera_front_pitch" value="0.0"/>
  <xacro:property name="camera_front_yaw" value="0.0"/>

  <!--
    TODO: camera_rear extrinsic is a placeholder, same as camera_front above.
    yaw is pi (facing backward) since that's the one thing known about a
    rear-facing mount; everything else needs measuring once it's mounted.
  -->
  <xacro:property name="camera_rear_x" value="${-wheelbase / 2.0}"/>
  <xacro:property name="camera_rear_y" value="0.0"/>
  <xacro:property name="camera_rear_z" value="${camera_height}"/>
  <xacro:property name="camera_rear_roll" value="0.0"/>
  <xacro:property name="camera_rear_pitch" value="0.0"/>
  <xacro:property name="camera_rear_yaw" value="${pi}"/>

  <material name="body_color">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="${wheelbase} ${track_width} 0.1"/>
      </geometry>
      <material name="body_color"/>
    </visual>
  </link>

  <!-- Front camera mounting frame, fixed relative to base_link -->
  <link name="camera_front_link"/>

  <joint name="camera_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_link"/>
    <!-- TODO: calibrate real camera extrinsic offset and orientation -->
    <origin xyz="${camera_front_x} ${camera_front_y} ${camera_front_z}"
            rpy="${camera_front_roll} ${camera_front_pitch} ${camera_front_yaw}"/>
  </joint>

  <!-- Optical frame following REP 103 (x-right, y-down, z-forward) -->
  <link name="camera_front_optical_frame"/>

  <joint name="camera_front_optical_joint" type="fixed">
    <parent link="camera_front_link"/>
    <child link="camera_front_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Rear camera mounting frame, fixed relative to base_link -->
  <link name="camera_rear_link"/>

  <joint name="camera_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_rear_link"/>
    <!-- TODO: calibrate real camera extrinsic offset and orientation -->
    <origin xyz="${camera_rear_x} ${camera_rear_y} ${camera_rear_z}"
            rpy="${camera_rear_roll} ${camera_rear_pitch} ${camera_rear_yaw}"/>
  </joint>

  <!-- Optical frame following REP 103 (x-right, y-down, z-forward) -->
  <link name="camera_rear_optical_frame"/>

  <joint name="camera_rear_optical_joint" type="fixed">
    <parent link="camera_rear_link"/>
    <child link="camera_rear_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

</robot>
