<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>autodrive_vehicle</name>
  <version>0.0.1</version>
  <description>Bridges ROS commands to the Arduino Mega low-level actuator controller and runs the low-level steering PID. The real serial protocol is not implemented yet.</description>
  <maintainer email="ahnjskevin@naver.com">rozen</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>autodrive_sensors</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
